# Server Port
PORT=3000

# Database Connection
MONGO_URL=mongodb://localhost:27017/DB_Name

# Public Backend URL (production mein live domain)
APP_URL=http://localhost:3000

# Allowed Frontend URL for CORS
CLIENT_URL=http://localhost:5173

# Environment
NODE_ENV=development

# JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_chars
ACCESS_SECRET_EXPIRES=15m
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_chars
REFRESH_SECRET_EXPIRES=7d

# ==========================================
# SMTP Email Configuration Options
# ==========================================
# OPTION 1: Gmail (Free & Quick)
# Generate a 16-character App Password at: https://myaccount.google.com/apppasswords
# SMTP_SERVICE=gmail
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_16_character_app_password
# SMTP_FROM_USER=SnapURL
# SMTP_FROM_EMAIL=your_email@gmail.com

# OPTION 2: Custom SMTP / Mailtrap / Brevo
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_app_password
SMTP_FROM_USER=SnapURL
SMTP_FROM_EMAIL=your_email@gmail.com